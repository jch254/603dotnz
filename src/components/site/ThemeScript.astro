---
/**
 * Theme, set before first paint by public/theme.js. The script is a file and
 * not inline because the content security policy on both sites only runs
 * scripts from their own origin. The meta tag must come before the script,
 * which updates it for the theme in use.
 */
---

<meta name="theme-color" content="#fbfbf8" />
<script is:inline src="/theme.js"></script>
